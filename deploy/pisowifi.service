[Unit]
Description=Piso WiFi vending service
Documentation=file:///usr/local/share/doc/pisowifi/README.md
After=network-online.target nftables.service dnsmasq.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pisowifi --config /etc/pisowifi/config.toml run
Restart=always
RestartSec=2
UMask=0077
StateDirectory=pisowifi
StateDirectoryMode=0700

# Root is only needed for nftables and port 80; everything else is taken away.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pisowifi
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip1 rw

[Install]
WantedBy=multi-user.target
