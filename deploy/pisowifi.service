[Unit]
Description=Piso WiFi vending service
Documentation=file:///usr/local/share/doc/pisowifi/README.md
# Doesn't wait for the internet: the portal and coin slot work without it,
# and the listeners don't need the LAN address yet (IP_FREEBIND).
After=network.target nftables.service dnsmasq.service
# Restarting nftables flushes customers' access; restarting with it puts it back.
PartOf=nftables.service
# Keep retrying (e.g. while something else still holds port 80).
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/pisowifi --config /etc/pisowifi/config.toml run
Restart=always
RestartSec=2
UMask=0077
StateDirectory=pisowifi
StateDirectoryMode=0700

# Root is only needed for nftables and port 80; everything else is taken away.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pisowifi
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip1 rw

[Install]
WantedBy=multi-user.target
