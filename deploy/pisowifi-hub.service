[Unit]
Description=Piso Pass hub
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/pisowifi hub --hub-config /etc/pisowifi/hub.toml run
Restart=always
RestartSec=2
DynamicUser=yes
StateDirectory=pisowifi-hub
StateDirectoryMode=0700
UMask=0077
# Wallet passes (optional, README → Wallet passes): hand the signing keys to
# the hub without making the files readable by anyone else. Uncomment the
# lines for the wallets you use; the hub sees them under
# /run/credentials/pisowifi-hub.service/.
#LoadCredential=google-wallet.json:/etc/pisowifi/wallet/google-service-account.json
#LoadCredential=pass-cert.pem:/etc/pisowifi/wallet/pass-cert.pem
#LoadCredential=pass-key.pem:/etc/pisowifi/wallet/pass-key.pem
#LoadCredential=wwdr.pem:/etc/pisowifi/wallet/wwdr.pem
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
