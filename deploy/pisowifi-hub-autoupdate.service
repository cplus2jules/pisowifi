[Unit]
Description=Install a new Piso Pass hub version from the update list, if there is one
# Started by pisowifi-hub-autoupdate.timer (off until you enable it). The
# install itself is pisowifi-hub-update.service, with its automatic rollback.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pisowifi hub --hub-config /etc/pisowifi/hub.toml update --auto
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/pisowifi-update
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
