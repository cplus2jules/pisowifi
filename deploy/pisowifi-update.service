[Unit]
Description=Install a staged Piso WiFi update, rolling back if it doesn't start
Documentation=file:///usr/local/share/doc/pisowifi/README.md
# Also runs at boot, to finish or undo an update that a power cut interrupted.
After=pisowifi.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pisowifi --config /etc/pisowifi/config.toml update --run-pending
# Checks, a 90 s trial of the new version, and possibly a rollback with its own trial.
TimeoutStartSec=15min
# Runs as root outside the vendo's sandbox (it swaps binaries and units), so
# it trusts nothing the vendo staged: signature and checksum are checked again.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/usr/local/lib/pisowifi -/usr/local/bin -/etc/systemd/system -/var/lib/pisowifi
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
